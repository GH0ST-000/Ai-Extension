# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/projectx?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug
API_JSON_BODY_LIMIT_BYTES=1048576
API_MAX_PAGE_SIZE=100

# AI (Vercel AI SDK — OpenAI provider)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-replace-me
AI_MAX_OUTPUT_TOKENS=600
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_INPUT_CHARACTERS=12000
# Production: comma-separated exact origins (dashboard + chrome-extension://ID). No wildcards.
AI_CORS_ORIGINS=
# Exact page origins used by extension content scripts (e.g. https://github.com,https://*.atlassian.net is NOT supported — list exact hosts).
AI_CORS_CONTENT_SCRIPT_ORIGINS=

# Auth
JWT_SECRET=project-x-dev-jwt-secret-change-me
JWT_EXPIRES_IN=12h
# Required in production (≥32 chars, distinct from JWT_SECRET)
TOKEN_ENCRYPTION_KEY=project-x-dev-token-encryption-key

# App
APP_BASE_URL=http://localhost:3000

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:3001

# Extension (Plasmo public — no secrets)
PLASMO_PUBLIC_API_URL=http://localhost:3001
# Optional release tag for client telemetry
# PLASMO_PUBLIC_APP_RELEASE=

# Paddle (optional in development)
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_CLIENT_TOKEN=
# PADDLE_PRICE_PRO_MONTHLY=
# PADDLE_PRICE_PRO_YEARLY=
# PADDLE_PRICE_TEAM_MONTHLY=
# PADDLE_PRICE_TEAM_YEARLY=

# Day 26 — Observability (all optional in development; tokens required in production)
# APP_RELEASE=local-dev
# APP_SERVICE=api
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# OBSERVABILITY_TRACE_SAMPLE_RATE=0.2
# METRICS_SCRAPE_TOKEN=
# INTERNAL_OBSERVABILITY_TOKEN=
# HEALTH_DETAILS_TOKEN=
# SLOW_HTTP_MS=5000
# SLOW_AI_MS=30000
# SLOW_PROVIDER_MS=8000
