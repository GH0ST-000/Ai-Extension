# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/projectx?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# AI (Vercel AI SDK — OpenAI provider)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-replace-me
AI_MAX_OUTPUT_TOKENS=600
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_INPUT_CHARACTERS=12000
# Comma-separated extra browser origins (chrome-extension:// IDs optional). Localhost dashboard is always allowed in development.
AI_CORS_ORIGINS=

# Auth
JWT_SECRET=project-x-dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d
# Optional — encrypts per-user GitHub PATs at rest (falls back to JWT_SECRET)
TOKEN_ENCRYPTION_KEY=project-x-dev-token-encryption-key

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:3001

# Extension (Plasmo public — no secrets)
PLASMO_PUBLIC_API_URL=http://localhost:3001
