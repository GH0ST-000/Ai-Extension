{
  "name": "@project-x/api",
  "version": "0.0.0",
  "private": true,
  "description": "Project X NestJS API",
  "scripts": {
    "build": "nest build",
    "dev": "node ../../scripts/wait-for-workspace-builds.mjs && nest build && nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test:integration": "bash test/integration/run-memory-it.sh",
    "test:integration:ci": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.121",
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.5.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/terminus": "^12.2.0",
    "@paddle/paddle-node-sdk": "^3.12.0",
    "@prisma/client": "^7.10.1",
    "@project-x/config": "workspace:*",
    "@project-x/shared": "workspace:*",
    "@project-x/types": "workspace:*",
    "@sentry/node": "^11.14.0",
    "ai": "^7.0.177",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.7.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.5.0",
    "nestjs-pino": "^5.3.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@project-x/eslint-config": "workspace:*",
    "@project-x/tsconfig": "workspace:*",
    "@swc/core": "^1.15.46",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.17.0",
    "prisma": "^6.1.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}
