generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HealthProbe {
  id        String   @id @default(cuid())
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_probes")
}

enum ResponseStyle {
  CONCISE
  BALANCED
  DETAILED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  name         String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  settings     UserSettings?
  githubConnection GitHubConnection?
  jiraConnection   JiraConnection?
  projectMemories  ProjectMemory[]

  @@map("users")
}

model UserSettings {
  id                 String        @id @default(cuid())
  userId             String        @unique @map("user_id")
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxOutputTokens    Int           @default(600) @map("max_output_tokens")
  responseStyle      ResponseStyle @default(CONCISE) @map("response_style")
  includePageContext Boolean       @default(true) @map("include_page_context")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@map("user_settings")
}

/** Per-user GitHub PAT — ciphertext only; never expose raw token via API. */
model GitHubConnection {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenCiphertext String   @map("token_ciphertext") @db.Text
  githubUserId    String?  @map("github_user_id")
  githubLogin     String?  @map("github_login")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("github_connections")
}

/**
 * Per-user Jira Cloud API token connection — ciphertext only.
 * Day 17 is read-only (no Jira write scopes/calls).
 */
model JiraConnection {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email            String
  tokenCiphertext  String   @map("token_ciphertext") @db.Text
  siteHost         String   @map("site_host")
  siteDisplayName  String?  @map("site_display_name")
  accountId        String?  @map("account_id")
  displayName      String?  @map("display_name")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("jira_connections")
}

/**
 * Day 22 — per-user repository-scoped project memory.
 * Identity: userId + github owner/repo (normalized). No embeddings / vector store.
 */
model ProjectMemory {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           String   @default("github")
  owner              String
  repository         String
  category           String
  key                String
  valueJson          Json     @map("value_json")
  confidence         String
  status             String   @default("active")
  scopeJson          Json     @map("scope_json")
  freshnessJson      Json?    @map("freshness_json")
  provenanceJson     Json     @map("provenance_json")
  scopeFingerprint   String   @map("scope_fingerprint")
  supersedesMemoryId String?  @map("supersedes_memory_id")
  disputedFingerprint String? @map("disputed_fingerprint")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  lastConfirmedAt    DateTime? @map("last_confirmed_at")

  @@index([userId, owner, repository, status], map: "project_memory_user_repo_status_idx")
  @@index([userId, owner, repository, category], map: "project_memory_user_repo_category_idx")
  @@index([userId, owner, repository, key], map: "project_memory_user_repo_key_idx")
  @@index([userId, provider, owner, repository, category, key, scopeFingerprint], map: "project_memory_lookup_idx")
  @@map("project_memories")
}
