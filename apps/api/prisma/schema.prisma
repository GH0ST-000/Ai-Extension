generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HealthProbe {
  id        String   @id @default(cuid())
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_probes")
}

enum ResponseStyle {
  CONCISE
  BALANCED
  DETAILED
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String        @map("password_hash")
  name           String?
  /** Incremented on logout to invalidate previously issued JWTs. */
  sessionVersion Int           @default(0) @map("session_version")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  settings       UserSettings?
  refreshTokens  RefreshToken[]
  githubConnection GitHubConnection?
  jiraConnection   JiraConnection?
  projectMemories  ProjectMemory[]
  projectSystems   ProjectSystem[]
  repositoryRelationships RepositoryRelationship[]
  workflowExecutions WorkflowExecution[]
  promptSnapshots  PromptSnapshot[]
  lastWorkspaceId  String?   @map("last_workspace_id")
  lastWorkspace    Workspace? @relation("UserLastWorkspace", fields: [lastWorkspaceId], references: [id], onDelete: SetNull)
  workspaceMemberships WorkspaceMembership[]
  workspaceInvitationsSent WorkspaceInvitation[] @relation("WorkspaceInvitationInviter")
  workspaceInvitationsAccepted WorkspaceInvitation[] @relation("WorkspaceInvitationAccepter")
  createdWorkspaces Workspace[] @relation("WorkspaceCreator")
  createdProjectMemories ProjectMemory[] @relation("ProjectMemoryCreator")
  createdProjectSystems ProjectSystem[] @relation("ProjectSystemCreator")

  @@map("users")
}

/**
 * Rotating refresh tokens — store hash only.
 * Reuse of a revoked token in a family revokes the entire family (theft detection).
 */
model RefreshToken {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** SHA-256 hex of the opaque refresh token. */
  tokenHash        String    @unique @map("token_hash")
  /** Login/session family — all rotations share one family id. */
  familyId         String    @map("family_id")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  replacedByTokenId String?  @map("replaced_by_token_id")
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ip               String?   @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model UserSettings {
  id                 String        @id @default(cuid())
  userId             String        @unique @map("user_id")
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxOutputTokens    Int           @default(600) @map("max_output_tokens")
  responseStyle      ResponseStyle @default(CONCISE) @map("response_style")
  includePageContext Boolean       @default(true) @map("include_page_context")
  /** Day 28 — onboarding version for future migrations. */
  onboardingVersion  Int           @default(1) @map("onboarding_version")
  welcomeSeenAt      DateTime?     @map("welcome_seen_at")
  onboardingDismissedAt DateTime?  @map("onboarding_dismissed_at")
  firstValueAt       DateTime?     @map("first_value_at")
  firstValueType     String?       @map("first_value_type")
  dismissedHintIds   Json          @default("[]") @map("dismissed_hint_ids")
  firstWriteEducationSeenAt DateTime? @map("first_write_education_seen_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@map("user_settings")
}

/** Per-user GitHub PAT — ciphertext only; never expose raw token via API. */
model GitHubConnection {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenCiphertext String   @map("token_ciphertext") @db.Text
  githubUserId    String?  @map("github_user_id")
  githubLogin     String?  @map("github_login")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("github_connections")
}

/**
 * Per-user Jira Cloud API token connection — ciphertext only.
 * Day 17 is read-only (no Jira write scopes/calls).
 */
model JiraConnection {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email            String
  tokenCiphertext  String   @map("token_ciphertext") @db.Text
  siteHost         String   @map("site_host")
  siteDisplayName  String?  @map("site_display_name")
  accountId        String?  @map("account_id")
  displayName      String?  @map("display_name")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("jira_connections")
}

/**
 * Day 25 — workspace tenancy boundary.
 * status: active | suspended | deleted
 */
model Workspace {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  status           String   @default("active")
  createdByUserId  String?  @map("created_by_user_id")
  createdByUser    User?    @relation("WorkspaceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  memberships      WorkspaceMembership[]
  invitations      WorkspaceInvitation[]
  subscription     WorkspaceSubscription?
  usageCounters    WorkspaceUsageCounter[]
  usageEvents      WorkspaceUsageEvent[]
  lastWorkspaceUsers User[] @relation("UserLastWorkspace")
  projectMemories  ProjectMemory[]
  projectSystems   ProjectSystem[]
  repositoryRelationships RepositoryRelationship[]
  workflowExecutions WorkflowExecution[]
  promptSnapshots  PromptSnapshot[]
  workflowAuditEvents WorkflowAuditEvent[]
  executionCheckpoints ExecutionCheckpoint[]
  executionFailures ExecutionFailure[]
  githubAppInstallation GitHubAppInstallation?

  @@index([status])
  @@map("workspaces")
}

/**
 * Workspace-scoped GitHub App installation — no long-lived installation tokens stored.
 * Mint installation access tokens on demand via app JWT (RS256).
 */
model GitHubAppInstallation {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique @map("workspace_id")
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /** GitHub installation id (numeric string). */
  installationId       String    @unique @map("installation_id")
  accountLogin         String    @map("account_login")
  accountType          String    @map("account_type")
  repositorySelection  String?   @map("repository_selection")
  /** active | suspended | removed */
  status               String    @default("active")
  /** Optional encrypted JSON metadata from GitHub (permissions snapshot, etc.). */
  metadataCiphertext   String?   @map("metadata_ciphertext") @db.Text
  installedByUserId    String?   @map("installed_by_user_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("github_app_installations")
}

model WorkspaceMembership {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String
  status      String   @default("active")
  joinedAt    DateTime? @map("joined_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@index([workspaceId, status])
  @@map("workspace_memberships")
}

model WorkspaceInvitation {
  id               String   @id @default(cuid())
  workspaceId      String   @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email            String
  role             String
  tokenHash        String   @unique @map("token_hash")
  status           String   @default("pending")
  expiresAt        DateTime @map("expires_at")
  invitedByUserId  String   @map("invited_by_user_id")
  invitedByUser    User     @relation("WorkspaceInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedByUserId String?  @map("accepted_by_user_id")
  acceptedByUser   User?    @relation("WorkspaceInvitationAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@index([email, status])
  @@map("workspace_invitations")
}

model WorkspaceSubscription {
  id                      String   @id @default(cuid())
  workspaceId             String   @unique @map("workspace_id")
  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider                String   @default("paddle")
  planId                  String   @map("plan_id")
  status                  String
  billingCycle            String?  @map("billing_cycle")
  providerCustomerId      String?  @map("provider_customer_id")
  providerSubscriptionId  String?  @map("provider_subscription_id")
  currentPeriodStart      DateTime? @map("current_period_start")
  currentPeriodEnd        DateTime? @map("current_period_end")
  cancelAtPeriodEnd       Boolean  @default(false) @map("cancel_at_period_end")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@index([providerSubscriptionId])
  @@map("workspace_subscriptions")
}

model BillingWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String   @map("event_id")
  eventType   String   @map("event_type")
  payloadJson Json     @map("payload_json")
  processedAt DateTime @default(now()) @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([provider, eventType])
  @@map("billing_webhook_events")
}

model WorkspaceUsageCounter {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metric      String
  periodKey   String   @map("period_key")
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, metric, periodKey])
  @@map("workspace_usage_counters")
}

model WorkspaceUsageEvent {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metric          String
  periodKey       String   @map("period_key")
  idempotencyKey  String   @map("idempotency_key")
  quantity        Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, metric, periodKey])
  @@map("workspace_usage_events")
}

/**
 * Day 22 — repository-scoped project memory (workspace-scoped as of Day 25).
 * Identity: workspaceId + github owner/repo (normalized). No embeddings / vector store.
 * USER_PREFERENCE rows use visibility='user' and remain actor-private.
 */
model ProjectMemory {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId        String?  @map("workspace_id")
  workspace          Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUserId    String?  @map("created_by_user_id")
  createdByUser      User?    @relation("ProjectMemoryCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  visibility         String   @default("workspace")
  provider           String   @default("github")
  owner              String
  repository         String
  category           String
  key                String
  valueJson          Json     @map("value_json")
  confidence         String
  status             String   @default("active")
  scopeJson          Json     @map("scope_json")
  freshnessJson      Json?    @map("freshness_json")
  provenanceJson     Json     @map("provenance_json")
  scopeFingerprint   String   @map("scope_fingerprint")
  supersedesMemoryId String?  @map("supersedes_memory_id")
  disputedFingerprint String? @map("disputed_fingerprint")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  lastConfirmedAt    DateTime? @map("last_confirmed_at")

  @@index([workspaceId, owner, repository, status], map: "project_memory_ws_repo_status_idx")
  @@index([workspaceId, owner, repository, category], map: "project_memory_ws_repo_category_idx")
  @@index([workspaceId, owner, repository, key], map: "project_memory_ws_repo_key_idx")
  @@index([workspaceId, provider, owner, repository, category, key, scopeFingerprint], map: "project_memory_ws_lookup_idx")
  @@index([userId, owner, repository, status], map: "project_memory_user_repo_status_idx")
  @@index([userId, owner, repository, category], map: "project_memory_user_repo_category_idx")
  @@index([userId, owner, repository, key], map: "project_memory_user_repo_key_idx")
  @@index([userId, provider, owner, repository, category, key, scopeFingerprint], map: "project_memory_lookup_idx")
  @@map("project_memories")
}

/**
 * Day 23 — multi-repository system grouping (workspace-scoped as of Day 25).
 * Relationships are typed edges, not a graph DB.
 */
model ProjectSystem {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId       String   @map("workspace_id")
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUserId   String?  @map("created_by_user_id")
  createdByUser     User?    @relation("ProjectSystemCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  name              String
  primaryProvider   String   @default("github") @map("primary_provider")
  primaryOwner      String   @map("primary_owner")
  primaryRepository String   @map("primary_repository")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  repositories      ProjectSystemRepository[]
  relationships     RepositoryRelationship[]

  @@index([userId])
  @@index([workspaceId])
  @@map("project_systems")
}

model ProjectSystemRepository {
  id         String        @id @default(cuid())
  systemId   String        @map("system_id")
  system     ProjectSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  provider   String        @default("github")
  owner      String
  repository String
  role       String        @default("unknown")
  enabled    Boolean       @default(true)
  source     String        @default("user_selected")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@unique([systemId, provider, owner, repository])
  @@index([systemId])
  @@map("project_system_repositories")
}

model RepositoryRelationship {
  id               String        @id @default(cuid())
  userId           String        @map("user_id")
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId      String        @map("workspace_id")
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  systemId         String        @map("system_id")
  system           ProjectSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  fromOwner        String        @map("from_owner")
  fromRepository   String        @map("from_repository")
  toOwner          String        @map("to_owner")
  toRepository     String        @map("to_repository")
  type             String
  resourceKind     String?       @map("resource_kind")
  resourceKey      String?       @map("resource_key")
  confidence       String
  status           String        @default("active")
  freshnessJson    Json?         @map("freshness_json")
  provenanceJson   Json          @map("provenance_json")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  lastValidatedAt  DateTime?     @map("last_validated_at")

  @@index([userId, systemId])
  @@index([workspaceId, systemId])
  @@index([systemId, type, status])
  @@index([systemId, fromOwner, fromRepository])
  @@index([systemId, toOwner, toRepository])
  @@index([systemId, resourceKind, resourceKey])
  @@map("repository_relationships")
}

/**
 * Day 24 — Reliability Engine.
 * Durable workflow executions, audit events, prompt snapshots, checkpoints, failures.
 * Workspace-scoped as of Day 25; userId remains the actor.
 */
model WorkflowExecution {
  id                 String   @id
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId        String   @map("workspace_id")
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflowId         String   @map("workflow_id")
  executionNumber    Int      @map("execution_number")
  trigger            String
  status             String
  healthScore        Int      @default(100) @map("health_score")
  healthBand         String   @default("Excellent") @map("health_band")
  startedAt          DateTime @map("started_at")
  completedAt        DateTime? @map("completed_at")
  durationMs         Int?     @map("duration_ms")
  parentExecutionId  String?  @map("parent_execution_id")
  goal               String?
  contextVersionJson Json     @map("context_version_json")
  snapshotJson       Json?    @map("snapshot_json")
  lineageJson        Json?    @map("lineage_json")
  healthSignalsJson  Json?    @map("health_signals_json")
  aiRequestsJson     Json?    @map("ai_requests_json")
  promptSnapshotId   String?  @map("prompt_snapshot_id")
  promptSnapshot     PromptSnapshot? @relation(fields: [promptSnapshotId], references: [id], onDelete: SetNull)
  resumeAvailable    Boolean  @default(false) @map("resume_available")
  replayAvailable    Boolean  @default(true) @map("replay_available")
  artifactCount      Int      @default(0) @map("artifact_count")
  failureCount       Int      @default(0) @map("failure_count")
  retryCount         Int      @default(0) @map("retry_count")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  auditEvents        WorkflowAuditEvent[]
  checkpoints        ExecutionCheckpoint[]
  failures           ExecutionFailure[]

  @@unique([workspaceId, workflowId, executionNumber])
  @@index([workspaceId, startedAt])
  @@index([workspaceId, workflowId])
  @@index([workspaceId, status])
  @@index([userId, startedAt])
  @@index([userId, workflowId])
  @@index([userId, status])
  @@map("workflow_executions")
}

model WorkflowAuditEvent {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executionId String   @map("execution_id")
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  workflowId  String   @map("workflow_id")
  type        String
  timestamp   DateTime
  stepId      String?  @map("step_id")
  artifactId  String?  @map("artifact_id")
  message     String?
  metadataJson Json?   @map("metadata_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([executionId, timestamp])
  @@index([workspaceId, workflowId])
  @@index([userId, workflowId])
  @@map("workflow_audit_events")
}

model PromptSnapshot {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String   @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  version     Int
  hash        String
  capability  String?
  action      String?
  body        String   @db.Text
  truncated   Boolean  @default(false)
  redacted    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  executions  WorkflowExecution[]

  @@unique([workspaceId, name, hash])
  @@index([workspaceId, name, version])
  @@index([userId, name, version])
  @@map("prompt_snapshots")
}

model ExecutionCheckpoint {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executionId String   @map("execution_id")
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  kind        String
  label       String
  stepId      String?  @map("step_id")
  stateJson   Json     @map("state_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([executionId, createdAt])
  @@index([workspaceId, executionId])
  @@index([userId, executionId])
  @@map("execution_checkpoints")
}

model ExecutionFailure {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  workspaceId      String   @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executionId      String   @map("execution_id")
  execution        WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  category         String
  retryable        Boolean
  userMessage      String   @map("user_message")
  technicalReason  String   @map("technical_reason")
  stage            String?
  code             String?
  metadataJson     Json?    @map("metadata_json")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([executionId, createdAt])
  @@index([workspaceId, category])
  @@index([userId, category])
  @@map("execution_failures")
}
