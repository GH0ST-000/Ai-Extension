generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HealthProbe {
  id        String   @id @default(cuid())
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_probes")
}

enum ResponseStyle {
  CONCISE
  BALANCED
  DETAILED
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String        @map("password_hash")
  name           String?
  /** Incremented on logout to invalidate previously issued JWTs. */
  sessionVersion Int           @default(0) @map("session_version")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  settings       UserSettings?
  refreshTokens  RefreshToken[]
  githubConnection GitHubConnection?
  jiraConnection   JiraConnection?
  projectMemories  ProjectMemory[]
  projectSystems   ProjectSystem[]
  repositoryRelationships RepositoryRelationship[]
  workflowExecutions WorkflowExecution[]
  promptSnapshots  PromptSnapshot[]
  lastWorkspaceId  String?   @map("last_workspace_id")
  lastWorkspace    Workspace? @relation("UserLastWorkspace", fields: [lastWorkspaceId], references: [id], onDelete: SetNull)
  workspaceMemberships WorkspaceMembership[]
  workspaceInvitationsSent WorkspaceInvitation[] @relation("WorkspaceInvitationInviter")
  workspaceInvitationsAccepted WorkspaceInvitation[] @relation("WorkspaceInvitationAccepter")
  createdWorkspaces Workspace[] @relation("WorkspaceCreator")
  createdProjectMemories ProjectMemory[] @relation("ProjectMemoryCreator")
  createdProjectSystems ProjectSystem[] @relation("ProjectSystemCreator")
  prReviewReports  PrReviewReport[]
  projectMemoryAuditEvents ProjectMemoryAuditEvent[]
  passwordResetTokens PasswordResetToken[]
  marketingConsentEvents MarketingConsentEvent[]
  acquisition      UserAcquisition?

  @@map("users")
}

/**
 * Rotating refresh tokens — store hash only.
 * Reuse of a revoked token in a family revokes the entire family (theft detection).
 */
model RefreshToken {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** SHA-256 hex of the opaque refresh token. */
  tokenHash        String    @unique @map("token_hash")
  /** Login/session family — all rotations share one family id. */
  familyId         String    @map("family_id")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  replacedByTokenId String?  @map("replaced_by_token_id")
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ip               String?   @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model UserSettings {
  id                 String        @id @default(cuid())
  userId             String        @unique @map("user_id")
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxOutputTokens    Int           @default(600) @map("max_output_tokens")
  responseStyle      ResponseStyle @default(CONCISE) @map("response_style")
  includePageContext Boolean       @default(true) @map("include_page_context")
  /** Day 28 — onboarding version for future migrations. */
  onboardingVersion  Int           @default(1) @map("onboarding_version")
  welcomeSeenAt      DateTime?     @map("welcome_seen_at")
  onboardingDismissedAt DateTime?  @map("onboarding_dismissed_at")
  firstValueAt       DateTime?     @map("first_value_at")
  firstValueType     String?       @map("first_value_type")
  dismissedHintIds   Json          @default("[]") @map("dismissed_hint_ids")
  firstWriteEducationSeenAt DateTime? @map("first_write_education_seen_at")
  /// Optional growth profile (segmentation only — not a workspace role). Stable enum values,
  /// validated by the API; see packages/types/src/growth-profile.ts.
  professionalRole   String?       @map("professional_role")
  usageIntent        String?       @map("usage_intent")
  primaryGoal        String?       @map("primary_goal")
  profileCompletedAt DateTime?     @map("profile_completed_at")
  profileSkippedAt   DateTime?     @map("profile_skipped_at")
  /// Current marketing email consent; history in marketing_consent_events.
  marketingEmailConsent     Boolean   @default(false) @map("marketing_email_consent")
  marketingConsentUpdatedAt DateTime? @map("marketing_consent_updated_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@map("user_settings")
}

/** Per-user GitHub PAT — ciphertext only; never expose raw token via API. */
model GitHubConnection {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenCiphertext String   @map("token_ciphertext") @db.Text
  githubUserId    String?  @map("github_user_id")
  githubLogin     String?  @map("github_login")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("github_connections")
}

/**
 * Per-user Jira Cloud API token connection — ciphertext only.
 * Day 17 is read-only (no Jira write scopes/calls).
 */
model JiraConnection {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email            String
  tokenCiphertext  String   @map("token_ciphertext") @db.Text
  siteHost         String   @map("site_host")
  siteDisplayName  String?  @map("site_display_name")
  accountId        String?  @map("account_id")
  displayName      String?  @map("display_name")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("jira_connections")
}

/**
 * Day 25 — workspace tenancy boundary.
 * status: active | suspended | deleted
 */
model Workspace {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  status           String   @default("active")
  createdByUserId  String?  @map("created_by_user_id")
  createdByUser    User?    @relation("WorkspaceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  memberships      WorkspaceMembership[]
  invitations      WorkspaceInvitation[]
  subscription     WorkspaceSubscription?
  usageCounters    WorkspaceUsageCounter[]
  usageEvents      WorkspaceUsageEvent[]
  lastWorkspaceUsers User[] @relation("UserLastWorkspace")
  projectMemories  ProjectMemory[]
  projectSystems   ProjectSystem[]
  repositoryRelationships RepositoryRelationship[]
  workflowExecutions WorkflowExecution[]
  promptSnapshots  PromptSnapshot[]
  workflowAuditEvents WorkflowAuditEvent[]
  executionCheckpoints ExecutionCheckpoint[]
  executionFailures ExecutionFailure[]
  githubAppInstallation GitHubAppInstallation?
  prReviewReports  PrReviewReport[]
  projectMemoryAuditEvents ProjectMemoryAuditEvent[]

  @@index([status])
  @@map("workspaces")
}

/**
 * Workspace-scoped GitHub App installation — no long-lived installation tokens stored.
 * Mint installation access tokens on demand via app JWT (RS256).
 */
model GitHubAppInstallation {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique @map("workspace_id")
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /** GitHub installation id (numeric string). */
  installationId       String    @unique @map("installation_id")
  accountLogin         String    @map("account_login")
  accountType          String    @map("account_type")
  repositorySelection  String?   @map("repository_selection")
  /** active | suspended | removed */
  status               String    @default("active")
  /** Optional encrypted JSON metadata from GitHub (permissions snapshot, etc.). */
  metadataCiphertext   String?   @map("metadata_ciphertext") @db.Text
  installedByUserId    String?   @map("installed_by_user_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("github_app_installations")
}

model WorkspaceMembership {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String
  status      String   @default("active")
  joinedAt    DateTime? @map("joined_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@index([workspaceId, status])
  @@map("workspace_memberships")
}

model WorkspaceInvitation {
  id               String   @id @default(cuid())
  workspaceId      String   @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email            String
  role             String
  tokenHash        String   @unique @map("token_hash")
  status           String   @default("pending")
  expiresAt        DateTime @map("expires_at")
  invitedByUserId  String   @map("invited_by_user_id")
  invitedByUser    User     @relation("WorkspaceInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedByUserId String?  @map("accepted_by_user_id")
  acceptedByUser   User?    @relation("WorkspaceInvitationAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@index([email, status])
  @@map("workspace_invitations")
}

model WorkspaceSubscription {
  id                      String   @id @default(cuid())
  workspaceId             String   @unique @map("workspace_id")
  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider                String   @default("paddle")
  planId                  String   @map("plan_id")
  status                  String
  billingCycle            String?  @map("billing_cycle")
  providerCustomerId      String?  @map("provider_customer_id")
  providerSubscriptionId  String?  @map("provider_subscription_id")
  currentPeriodStart      DateTime? @map("current_period_start")
  currentPeriodEnd        DateTime? @map("current_period_end")
  cancelAtPeriodEnd       Boolean  @default(false) @map("cancel_at_period_end")
  /// Paddle's updated_at of the last applied state; older webhooks are ignored.
  providerUpdatedAt       DateTime? @map("provider_updated_at")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@index([providerSubscriptionId])
  @@map("workspace_subscriptions")
}

model BillingWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String   @map("event_id")
  eventType   String   @map("event_type")
  payloadJson Json     @map("payload_json")
  processedAt DateTime @default(now()) @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([provider, eventType])
  @@map("billing_webhook_events")
}

model WorkspaceUsageCounter {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metric      String
  periodKey   String   @map("period_key")
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, metric, periodKey])
  @@map("workspace_usage_counters")
}

model WorkspaceUsageEvent {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metric          String
  periodKey       String   @map("period_key")
  idempotencyKey  String   @map("idempotency_key")
  quantity        Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  /// Server-controlled lifecycle: "reserved" while the operation runs (counted, refundable),
  /// "committed" once charged. Rows created before reservations existed are committed.
  status          String   @default("committed")
  /// Authenticated user the operation ran for (null for legacy rows and non-user charges).
  userId          String?  @map("user_id")
  /// While reserved: one user's identical in-flight operation (unique per workspace); null
  /// once committed. Prevents duplicate concurrent model execution.
  inFlightKey     String?  @map("in_flight_key")
  finalizedAt     DateTime? @map("finalized_at")
  /// Hash of (user, action, logical request); kept after commit so a retry can be matched.
  requestKey      String?  @map("request_key")
  /// Lease of a running operation, renewed by heartbeat. Only an expired lease is recovered.
  leaseExpiresAt  DateTime? @map("lease_expires_at")
  /// Set once output reached the client: recovery then charges instead of refunding, and a
  /// refund is no longer possible.
  deliveredAt     DateTime? @map("delivered_at")
  /// Short-lived copy of the delivered result, replayed (no AI call, no charge) to the same
  /// user's retry of the same request when the response was lost. Cleared after expiry.
  resultText      String?  @map("result_text")
  resultMeta      Json?    @map("result_meta")
  resultExpiresAt DateTime? @map("result_expires_at")

  @@unique([workspaceId, idempotencyKey])
  @@unique([workspaceId, inFlightKey])
  @@index([workspaceId, metric, periodKey])
  @@index([workspaceId, status, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([workspaceId, resultExpiresAt])
  @@map("workspace_usage_events")
}

/**
 * Day 22 — repository-scoped project memory (workspace-scoped as of Day 25).
 * Identity: workspaceId + github owner/repo (normalized). No embeddings / vector store.
 * USER_PREFERENCE rows use visibility='user' and remain actor-private.
 */
model ProjectMemory {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId        String?  @map("workspace_id")
  workspace          Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUserId    String?  @map("created_by_user_id")
  createdByUser      User?    @relation("ProjectMemoryCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  visibility         String   @default("workspace")
  provider           String   @default("github")
  owner              String
  repository         String
  category           String
  key                String
  valueJson          Json     @map("value_json")
  confidence         String
  status             String   @default("active")
  scopeJson          Json     @map("scope_json")
  freshnessJson      Json?    @map("freshness_json")
  provenanceJson     Json     @map("provenance_json")
  scopeFingerprint   String   @map("scope_fingerprint")
  supersedesMemoryId String?  @map("supersedes_memory_id")
  disputedFingerprint String? @map("disputed_fingerprint")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  lastConfirmedAt    DateTime? @map("last_confirmed_at")

  @@index([workspaceId, owner, repository, status], map: "project_memory_ws_repo_status_idx")
  @@index([workspaceId, owner, repository, category], map: "project_memory_ws_repo_category_idx")
  @@index([workspaceId, owner, repository, key], map: "project_memory_ws_repo_key_idx")
  @@index([workspaceId, provider, owner, repository, category, key, scopeFingerprint], map: "project_memory_ws_lookup_idx")
  @@index([userId, owner, repository, status], map: "project_memory_user_repo_status_idx")
  @@index([userId, owner, repository, category], map: "project_memory_user_repo_category_idx")
  @@index([userId, owner, repository, key], map: "project_memory_user_repo_key_idx")
  @@index([userId, provider, owner, repository, category, key, scopeFingerprint], map: "project_memory_lookup_idx")
  // At most one ACTIVE row per slot is enforced by three partial unique indexes created in
  // migration 20261115090000_project_memory_active_slot_unique (Prisma 6 cannot declare
  // partial indexes): project_memory_active_{workspace,personal,legacy}_slot_uidx.
  // Do not accept a generated migration that drops them.
  @@map("project_memories")
}

/// Duplicate active Project Memory rows resolved (marked superseded, never deleted) when the
/// active-slot unique indexes were introduced. Reviewable / reversible record.
model ProjectMemoryDedupAudit {
  id             BigInt   @id @default(autoincrement())
  memoryId       String   @map("memory_id")
  keptMemoryId   String   @map("kept_memory_id")
  previousStatus String   @map("previous_status")
  reason         String
  resolvedAt     DateTime @default(now()) @map("resolved_at")

  @@index([memoryId], map: "project_memory_dedup_audit_memory_id_idx")
  @@map("project_memory_dedup_audit")
}

/**
 * Day 23 — multi-repository system grouping (workspace-scoped as of Day 25).
 * Relationships are typed edges, not a graph DB.
 */
model ProjectSystem {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId       String   @map("workspace_id")
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUserId   String?  @map("created_by_user_id")
  createdByUser     User?    @relation("ProjectSystemCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  name              String
  primaryProvider   String   @default("github") @map("primary_provider")
  primaryOwner      String   @map("primary_owner")
  primaryRepository String   @map("primary_repository")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  repositories      ProjectSystemRepository[]
  relationships     RepositoryRelationship[]

  @@index([userId])
  @@index([workspaceId])
  @@map("project_systems")
}

model ProjectSystemRepository {
  id         String        @id @default(cuid())
  systemId   String        @map("system_id")
  system     ProjectSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  provider   String        @default("github")
  owner      String
  repository String
  role       String        @default("unknown")
  enabled    Boolean       @default(true)
  source     String        @default("user_selected")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@unique([systemId, provider, owner, repository])
  @@index([systemId])
  @@map("project_system_repositories")
}

model RepositoryRelationship {
  id               String        @id @default(cuid())
  userId           String        @map("user_id")
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId      String        @map("workspace_id")
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  systemId         String        @map("system_id")
  system           ProjectSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  fromOwner        String        @map("from_owner")
  fromRepository   String        @map("from_repository")
  toOwner          String        @map("to_owner")
  toRepository     String        @map("to_repository")
  type             String
  resourceKind     String?       @map("resource_kind")
  resourceKey      String?       @map("resource_key")
  confidence       String
  status           String        @default("active")
  freshnessJson    Json?         @map("freshness_json")
  provenanceJson   Json          @map("provenance_json")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  lastValidatedAt  DateTime?     @map("last_validated_at")

  @@index([userId, systemId])
  @@index([workspaceId, systemId])
  @@index([systemId, type, status])
  @@index([systemId, fromOwner, fromRepository])
  @@index([systemId, toOwner, toRepository])
  @@index([systemId, resourceKind, resourceKey])
  @@map("repository_relationships")
}

/**
 * Day 24 — Reliability Engine.
 * Durable workflow executions, audit events, prompt snapshots, checkpoints, failures.
 * Workspace-scoped as of Day 25; userId remains the actor.
 */
model WorkflowExecution {
  id                 String   @id
  userId             String   @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId        String   @map("workspace_id")
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflowId         String   @map("workflow_id")
  executionNumber    Int      @map("execution_number")
  trigger            String
  status             String
  healthScore        Int      @default(100) @map("health_score")
  healthBand         String   @default("Excellent") @map("health_band")
  startedAt          DateTime @map("started_at")
  completedAt        DateTime? @map("completed_at")
  durationMs         Int?     @map("duration_ms")
  parentExecutionId  String?  @map("parent_execution_id")
  goal               String?
  contextVersionJson Json     @map("context_version_json")
  snapshotJson       Json?    @map("snapshot_json")
  lineageJson        Json?    @map("lineage_json")
  healthSignalsJson  Json?    @map("health_signals_json")
  aiRequestsJson     Json?    @map("ai_requests_json")
  promptSnapshotId   String?  @map("prompt_snapshot_id")
  promptSnapshot     PromptSnapshot? @relation(fields: [promptSnapshotId], references: [id], onDelete: SetNull)
  resumeAvailable    Boolean  @default(false) @map("resume_available")
  replayAvailable    Boolean  @default(true) @map("replay_available")
  artifactCount      Int      @default(0) @map("artifact_count")
  failureCount       Int      @default(0) @map("failure_count")
  retryCount         Int      @default(0) @map("retry_count")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  auditEvents        WorkflowAuditEvent[]
  checkpoints        ExecutionCheckpoint[]
  failures           ExecutionFailure[]

  @@unique([workspaceId, workflowId, executionNumber])
  @@index([workspaceId, startedAt])
  @@index([workspaceId, workflowId])
  @@index([workspaceId, status])
  @@index([userId, startedAt])
  @@index([userId, workflowId])
  @@index([userId, status])
  @@map("workflow_executions")
}

model WorkflowAuditEvent {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executionId String   @map("execution_id")
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  workflowId  String   @map("workflow_id")
  type        String
  timestamp   DateTime
  stepId      String?  @map("step_id")
  artifactId  String?  @map("artifact_id")
  message     String?
  metadataJson Json?   @map("metadata_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([executionId, timestamp])
  @@index([workspaceId, workflowId])
  @@index([userId, workflowId])
  @@map("workflow_audit_events")
}

model PromptSnapshot {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String   @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  version     Int
  hash        String
  capability  String?
  action      String?
  body        String   @db.Text
  truncated   Boolean  @default(false)
  redacted    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  executions  WorkflowExecution[]

  @@unique([workspaceId, name, hash])
  @@index([workspaceId, name, version])
  @@index([userId, name, version])
  @@map("prompt_snapshots")
}

model ExecutionCheckpoint {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executionId String   @map("execution_id")
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  kind        String
  label       String
  stepId      String?  @map("step_id")
  stateJson   Json     @map("state_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([executionId, createdAt])
  @@index([workspaceId, executionId])
  @@index([userId, executionId])
  @@map("execution_checkpoints")
}

model ExecutionFailure {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  workspaceId      String   @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executionId      String   @map("execution_id")
  execution        WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  category         String
  retryable        Boolean
  userMessage      String   @map("user_message")
  technicalReason  String   @map("technical_reason")
  stage            String?
  code             String?
  metadataJson     Json?    @map("metadata_json")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([executionId, createdAt])
  @@index([workspaceId, category])
  @@index([userId, category])
  @@map("execution_failures")
}

/**
 * Persistent PR review history: an immutable snapshot of one REVIEW_ENTIRE_PR execution,
 * written once when the run settles (completed / partial / failed) and never updated.
 * Reopened without any AI call, usage charge or GitHub write.
 * Privacy: no secrets, no credentials, no Project Memory rule text; personal (user-visibility)
 * memory rules are stored as a count only. Snapshot shape is versioned by `schemaVersion`.
 */
model PrReviewReport {
  id                      String    @id @default(cuid())
  /// Version of `snapshot` / `reportMarkdown` layout (readers must accept older versions).
  schemaVersion           Int       @default(1) @map("schema_version")
  workspaceId             String    @map("workspace_id")
  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Initiator. Null after the user was deleted (the workspace keeps its history).
  userId                  String?   @map("user_id")
  user                    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Server-chosen usage operation id: one report per execution (idempotent persistence).
  operationId             String    @map("operation_id")
  provider                String    @default("github")
  /// Lower-cased GitHub owner / repository (normalized for filtering).
  owner                   String
  repository              String
  pullRequestNumber       Int       @map("pull_request_number")
  pullRequestTitle        String?   @map("pull_request_title")
  headSha                 String?   @map("head_sha")
  baseBranch              String?   @map("base_branch")
  headBranch              String?   @map("head_branch")
  /// completed | partial | failed
  status                  String
  /// Stable machine code when failed (all_batches_failed, orchestrator_error).
  failureCode             String?   @map("failure_code")
  riskLevel               String?   @map("risk_level")
  diffSource              String?   @map("diff_source")
  findingsCount           Int       @default(0) @map("findings_count")
  needsInvestigationCount Int       @default(0) @map("needs_investigation_count")
  filesTotal              Int?      @map("files_total")
  filesReviewed           Int       @default(0) @map("files_reviewed")
  coverageComplete        Boolean   @default(false) @map("coverage_complete")
  /// Project Memory setting the review ran with (on / off) and its outcome status.
  memoryMode              String?   @map("memory_mode")
  memoryStatus            String?   @map("memory_status")
  /// Versioned structured snapshot (coverage, findings, verification, safe memory metadata).
  snapshot                Json
  /// Report exactly as delivered (Markdown with the coverage trailer). Null for failed runs.
  reportMarkdown          String?   @map("report_markdown")
  startedAt               DateTime  @map("started_at")
  completedAt             DateTime  @map("completed_at")
  createdAt               DateTime  @default(now()) @map("created_at")

  @@unique([workspaceId, operationId])
  @@index([workspaceId, createdAt(sort: Desc), id])
  @@index([workspaceId, owner, repository, pullRequestNumber, createdAt(sort: Desc)])
  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([userId])
  @@map("pr_review_reports")
}

/**
 * Append-only Project Memory audit log. One row per change to a memory rule, written in the
 * same transaction as the change. A database trigger rejects UPDATE (except detaching a
 * deleted actor) and DELETE (except when the workspace itself is deleted).
 * `memoryId` / `relatedMemoryId` are plain ids (no FK): history outlives deleted rules.
 * Personal preferences (`visibility = user`) are readable only by `subjectUserId` and never
 * store rule text. Auditing starts with this table; earlier history is not reconstructed.
 */
model ProjectMemoryAuditEvent {
  id              String     @id @default(cuid())
  schemaVersion   Int        @default(1) @map("schema_version")
  workspaceId     String     @map("workspace_id")
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memoryId        String     @map("memory_id")
  relatedMemoryId String?    @map("related_memory_id")
  /// rule_created | rule_reconfirmed | rule_edited | rule_archived | rule_disputed |
  /// rule_restored | rule_reactivated | rule_superseded
  eventType       String     @map("event_type")
  /// user | system
  actorType       String     @map("actor_type")
  actorUserId     String?    @map("actor_user_id")
  actorUser       User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Display name at the time of the event (never an email address).
  actorName       String?    @map("actor_name")
  reason          String?
  /// workspace (shared rule) | user (personal preference — readable by subjectUserId only)
  visibility      String
  /// Owner of a personal preference. Plain id: no FK, so history is never re-attributed.
  subjectUserId   String?    @map("subject_user_id")
  provider        String     @default("github")
  owner           String
  repository      String
  category        String
  key             String
  previousState   Json?      @map("previous_state")
  newState        Json?      @map("new_state")
  requestId       String?    @map("request_id")
  createdAt       DateTime   @default(now()) @map("created_at")

  @@index([workspaceId, createdAt(sort: Desc), id])
  @@index([workspaceId, memoryId, createdAt(sort: Desc)])
  @@index([workspaceId, actorUserId, createdAt(sort: Desc)])
  @@index([workspaceId, eventType, createdAt(sort: Desc)])
  @@index([workspaceId, owner, repository, createdAt(sort: Desc)])
  @@index([actorUserId])
  @@map("project_memory_audit_events")
}

/**
 * Single-use password reset tokens. Only the SHA-256 hash of the high-entropy random token is
 * stored (never the token). Valid for 30 minutes; consumed atomically (used_at) together with
 * the password change and session revocation. Rows are removed with the user.
 */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/**
 * Evidence of marketing email consent: one row per grant or withdrawal (no IP, no content).
 * The current state is UserSettings.marketingEmailConsent.
 */
model MarketingConsentEvent {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  granted       Boolean
  /// dashboard_signup | extension_signup | settings
  source        String
  /// Version id of the consent wording shown (MARKETING_CONSENT_VERSION).
  policyVersion String   @map("policy_version")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("marketing_consent_events")
}

/**
 * First-touch acquisition of an account, written once at registration and never overwritten.
 * Only allowlisted, length-limited UTM values, a referral slug and a referrer host.
 */
model UserAcquisition {
  userId       String   @id @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// dashboard | extension
  signupClient String   @map("signup_client")
  utmSource    String?  @map("utm_source")
  utmMedium    String?  @map("utm_medium")
  utmCampaign  String?  @map("utm_campaign")
  utmContent   String?  @map("utm_content")
  referral     String?
  referrerHost String?  @map("referrer_host")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([utmSource, createdAt])
  @@map("user_acquisitions")
}
