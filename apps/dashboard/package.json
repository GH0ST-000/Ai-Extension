    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@project-x/eslint-config": "workspace:*",
    "@project-x/tsconfig": "workspace:*",
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.6.0",
    "eslint": "^10.10.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
