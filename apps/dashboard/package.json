{
  "name": "@project-x/dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Project X Next.js dashboard",
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:fresh": "pnpm run clean && next dev --port 3000",
