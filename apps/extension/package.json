{
  "name": "@project-x/extension",
  "displayName": "Project X",
  "version": "0.0.1",
  "private": true,
  "description": "Project X Chrome extension (Plasmo)",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "preview": "pnpm run clean && plasmo build",
    "package": "plasmo package",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf build .plasmo"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@project-x/shared": "workspace:*",
    "@project-x/types": "workspace:*",
    "clsx": "^2.1.1",
    "framer-motion": "11",
    "plasmo": "^0.89.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@plasmohq/prettier-plugin-sort-imports": "^4.0.1",
    "@project-x/eslint-config": "workspace:*",
    "@project-x/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.6.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "manifest": {
    "host_permissions": [
      "http://localhost:3001/*",
      "http://127.0.0.1:3001/*"
    ],
    "optional_host_permissions": [
      "https://*/*",
      "http://*/*"
    ],
    "permissions": [
      "storage"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none';"
    }
  }
}
