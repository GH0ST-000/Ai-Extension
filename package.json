{
  "name": "project-x",
  "version": "0.0.0",
  "private": true,
  "description": "Project X — production-ready SaaS monorepo",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:security": "pnpm --filter @project-x/shared test -- security && pnpm --filter @project-x/api test -- security && pnpm --filter @project-x/extension test -- security",
    "audit:deps": "pnpm audit --audit-level=high",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@project-x/eslint-config": "workspace:*",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.18",
      "@types/react-dom": "18.3.5",
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "multer": ">=2.3.0",
      "@babel/traverse": ">=7.23.2",
      "msgpackr": ">=1.10.1",
      "content-security-policy-parser": ">=0.6.0",
      "glob": ">=10.5.0",
      "picomatch": ">=4.0.4",
      "lodash": ">=4.18.0",
      "tmp": ">=0.2.6",
      "sharp": ">=0.35.4",
      "postcss": ">=8.5.22",
      "undici": "^7.29.0",
      "fast-uri": ">=3.1.6",
      "js-yaml": ">=4.3.2",
      "nanoid": ">=3.3.18",
      "browserslist": ">=4.28.7",
      "svgo": ">=2.8.4",
      "brace-expansion@1.1.16": "1.1.18",
      "brace-expansion@2.1.2": "2.1.4",
      "brace-expansion@5.0.7": "5.0.9",
      "deepmerge-ts": ">=8.0.0"
    }
  }
}
